{
  "name": "flashview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx --test tests/browser.smoke.ts tests/transferRecovery.browser.ts",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test:browser:cloudflare": "node --import tsx tests/cloudflare-runner.ts",
    "prepare:pdf": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "npm run prepare:pdf",
    "predev:client": "npm run prepare:pdf",
    "bench:baseline": "node --import tsx tests/benchmark.baseline.ts",
    "bench:resume": "node --import tsx tests/resumeThroughput.ts"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.15",
    "pdfjs-dist": "^6.4.299",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "tsx": "^4.20.6",
    "pptx-vanilla-viewer": "3.42.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "playwright": "^1.55.0",
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^5.20261016.1"
  }
}
